# ==========================================
# HUGO & CLOUDFLARE PAGES
# ==========================================
# Diretório de saída gerado no build (recriado pelo Cloudflare Pages)
public/

# Arquivo de trava de build local do Hugo
.hugo_build.lock

# Nota: NÃO ignore 'resources/_gen/'. Versionar o cache de imagens WebP
# acelera drasticamente os deploys no Cloudflare Pages.

# ==========================================
# SEGREDOS E VARIÁVEIS DE AMBIENTE
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key

# ==========================================
# ARQUIVOS TEMPORÁRIOS E GARIMPO LOCAL
# ==========================================
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~
*.log

# ==========================================
# GO MODULES & BINÁRIOS (HUGO MODULES)
# ==========================================
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
!coverage.go
*.coverprofile
profile.cov
go.work
go.work.sum
# vendor/

# ==========================================
# DEPENDÊNCIAS AUXILIARES E SISTEMAS OPERACIONAIS
# ==========================================
node_modules/
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
.directory

# ==========================================
# EDITORES E IDEs
# ==========================================
.idea/
.vscode/
*.sublime-project
*.sublime-workspace